NODE_ENV=production
PORT=3001
DATABASE_URL=postgres://shuleledger_app:REPLACE_ME@db-host:5432/shuleledger
MIGRATIONS_DATABASE_URL=postgres://migration_user:REPLACE_ME@db-host:5432/shuleledger
# Generate a long random token. Remove or rotate after authorized initial provisioning.
BOOTSTRAP_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# Set to require only when your managed PostgreSQL provider requires verified TLS.
PGSSL=require

# Set true only after completing the production deployment and recovery checklist.
PRODUCTION_READINESS_ATTESTED=false
