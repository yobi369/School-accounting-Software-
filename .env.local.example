# Copy this file to .env before running Docker Compose.
# Use URL-safe characters (letters, numbers, hyphens) in passwords to avoid URL encoding issues.
SHULELEDGER_DB_OWNER_PASSWORD=replace-with-a-long-random-owner-password
SHULELEDGER_APP_PASSWORD=replace-with-a-different-long-random-app-password
SHULELEDGER_BOOTSTRAP_TOKEN=replace-with-a-long-random-one-time-setup-token
